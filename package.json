{
  "name": "@flefebvre/prisma-factorio",
  "version": "0.1.0",
  "description": "Laravel-style model factories for Prisma, fully typed",
  "license": "MIT",
  "author": "Florian Lefebvre <florian.lefebvre.contact@gmail.com>",
  "type": "module",
  "homepage": "https://github.com/flolefebvre/prisma-factorio#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flolefebvre/prisma-factorio.git"
  },
  "bugs": {
    "url": "https://github.com/flolefebvre/prisma-factorio/issues"
  },
  "keywords": [
    "prisma",
    "factory",
    "factories",
    "testing",
    "seeding",
    "fixtures",
    "laravel"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "generate": "prisma generate && prisma migrate diff --from-empty --to-schema=prisma/schema.prisma --script --output=src/tests/generated/schema.sql && echo '--generate OK--'",
    "clean": "rm -rf dist && echo '--clean OK--'",
    "prepublishOnly": "pnpm clean && pnpm build",
    "typecheck": "tsc --noEmit && echo '--typecheck OK--'",
    "lint": "eslint . && echo '--lint OK--'",
    "test": "vitest run && echo '--test OK--'",
    "build": "tsc -p tsconfig.build.json && echo '--build OK--'",
    "pack:check": "tsx scripts/check-pack.ts && echo '--pack:check OK--'",
    "format": "prettier --write .",
    "format:check": "prettier --check . && echo '--format:check OK--'",
    "duplicates": "jscpd && echo '--duplicates OK--'",
    "gates": "pnpm generate && pnpm typecheck && pnpm lint && pnpm format:check && pnpm duplicates && pnpm test && pnpm build && pnpm pack:check && echo '--gates OK--'"
  },
  "peerDependencies": {
    "@faker-js/faker": ">=10 <11",
    "@prisma/client": ">=7 <8",
    "prisma": ">=7 <8"
  },
  "peerDependenciesMeta": {
    "@faker-js/faker": {
      "optional": true
    },
    "prisma": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.5.0",
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/client": "7.8.0",
    "@types/node": "^26.1.1",
    "eslint": "^10.7.0",
    "jscpd": "^5.0.12",
    "prettier": "^3.9.5",
    "prisma": "7.8.0",
    "tsx": "^4.23.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@prisma/get-dmmf": "^7.9.0"
  }
}
