// Fixture schema for the prisma-factorio test harness. Covers the scalar and
// enum field-type matrix: required and optional variants of every scalar type,
// @default and @updatedAt fields, and differing id strategies per model. Also
// covers the relation-shape matrix the magic relationship methods emit over:
// a to-one and a to-many between the same pair (Post.author / User.posts), a
// second same-model relation (Post.reviewer / User.reviewedPosts), an implicit
// many-to-many (Post.tags / Tag.posts), and an explicit join model with pivot
// columns (PostTag).

datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client"
  output   = "../generated/client"
}

// `tsx` resolves from the PATH pnpm scripts set up, and the script path
// resolves relative to the Prisma CLI working directory, not this schema
// file; generate via `pnpm generate:fixtures` from the package root.
generator prismaFactorio {
  provider = "tsx src/generator.ts"
  output   = "../generated/prisma-factorio"
}

enum Role {
  ADMIN
  MEMBER
}

model User {
  id            String   @id @default(uuid())
  email         String
  name          String?
  role          Role
  backupRole    Role?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  posts         Post[]   @relation("Author")
  reviewedPosts Post[]   @relation("Reviewer")
}

model Post {
  id          Int       @id @default(autoincrement())
  title       String
  wordCount   Int
  views       BigInt
  rating      Float
  price       Decimal
  isPublished Boolean
  metadata    Json
  thumbnail   Bytes
  reviewedAt  DateTime
  publishedAt DateTime?
  authorId    String
  author      User      @relation("Author", fields: [authorId], references: [id])
  reviewerId  String?
  reviewer    User?     @relation("Reviewer", fields: [reviewerId], references: [id])
  tags        Tag[]     @relation("PostTags")
  postTags    PostTag[]
}

// Mutual-reference pair exercising factory-as-value cycle detection: a Chicken
// requires an Egg (belongsTo), an Egg optionally references its Chicken, so two
// generated factories can reference each other's factory in definition().
model Chicken {
  id    Int    @id @default(autoincrement())
  name  String
  eggId Int    @unique
  egg   Egg    @relation(fields: [eggId], references: [id])
}

model Egg {
  id      Int      @id @default(autoincrement())
  code    String
  chicken Chicken?
}

model Tag {
  id          Int       @id @default(autoincrement())
  label       String    @default("untagged")
  weight      Float?
  totalViews  BigInt?
  unitPrice   Decimal?
  isFeatured  Boolean?
  extra       Json?
  fingerprint Bytes?
  posts       Post[]    @relation("PostTags")
  postTags    PostTag[]
}

// Self-relation: a category nests categories, so the generated factory's magic
// methods (`hasChildren`, `forParent`) target the model's own class.
model Category {
  id       Int        @id @default(autoincrement())
  name     String
  parentId Int?
  parent   Category?  @relation("Subcategories", fields: [parentId], references: [id])
  children Category[] @relation("Subcategories")
}

// Explicit join model for the Post/Tag many-to-many: its two required
// belongsTo relations are ordinary to-one magic-method targets (forPost /
// forTag) and `active` / `note` are pivot columns like any other field. The
// library gives explicit joins no dedicated API — the join is just a model.
model PostTag {
  id     Int     @id @default(autoincrement())
  active Boolean @default(true)
  note   String?
  postId Int
  post   Post    @relation(fields: [postId], references: [id])
  tagId  Int
  tag    Tag     @relation(fields: [tagId], references: [id])
}
