// Fixture schema for the prisma-factorio test harness. Covers the scalar and
// enum field-type matrix: required and optional variants of every scalar type,
// @default and @updatedAt fields, and differing id strategies per model.

datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client"
  output   = "../generated/client"
}

// `tsx` resolves from the PATH pnpm scripts set up, and the script path
// resolves relative to the Prisma CLI working directory, not this schema
// file; generate via `pnpm generate:fixtures` from the package root.
generator prismaFactorio {
  provider = "tsx src/generator.ts"
  output   = "../generated/prisma-factorio"
}

enum Role {
  ADMIN
  MEMBER
}

model User {
  id         String   @id @default(uuid())
  email      String
  name       String?
  role       Role
  backupRole Role?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  posts      Post[]
}

model Post {
  id          Int       @id @default(autoincrement())
  title       String
  wordCount   Int
  views       BigInt
  rating      Float
  price       Decimal
  isPublished Boolean
  metadata    Json
  thumbnail   Bytes
  reviewedAt  DateTime
  publishedAt DateTime?
  authorId    String
  author      User      @relation(fields: [authorId], references: [id])
}

// Mutual-reference pair exercising factory-as-value cycle detection: a Chicken
// requires an Egg (belongsTo), an Egg optionally references its Chicken, so two
// generated factories can reference each other's factory in definition().
model Chicken {
  id    Int    @id @default(autoincrement())
  name  String
  eggId Int    @unique
  egg   Egg    @relation(fields: [eggId], references: [id])
}

model Egg {
  id      Int      @id @default(autoincrement())
  code    String
  chicken Chicken?
}

model Tag {
  id          Int      @id @default(autoincrement())
  label       String   @default("untagged")
  weight      Float?
  totalViews  BigInt?
  unitPrice   Decimal?
  isFeatured  Boolean?
  extra       Json?
  fingerprint Bytes?
}
